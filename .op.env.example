# 1Password secret references for fetching the Instapaper reading list.
#
# Copy this file to .op.env and replace the placeholder references with your
# local 1Password vault, item, and field paths. Do not put literal secret values
# in .op.env.

INSTAPAPER_CONSUMER_KEY=op://VAULT/ITEM/consumer_key
INSTAPAPER_CONSUMER_SECRET=op://VAULT/ITEM/consumer_secret
INSTAPAPER_OAUTH_TOKEN=op://VAULT/ITEM/oauth_token
INSTAPAPER_OAUTH_TOKEN_SECRET=op://VAULT/ITEM/oauth_token_secret

# Article metadata auto-generation.
# Used by npm run metadata:generate:op when auto_tags or sumup.mode = "auto"
# must be resolved.
GEMINI_API_KEY=op://VAULT/ITEM/gemini_api_key

# Thumbnail image generation (OpenAI gpt-image-2).
# Used by npm run metadata:generate:op when thumbnail.mode = "auto" must be
# resolved. Requires a billing-enabled OpenAI key.
OPENAI_API_KEY=op://VAULT/ITEM/openai_api_key

# Local database-backed content editor. Keep author and CI Access service
# tokens distinct. These values are available only to the local Node process;
# the browser bundle never receives them.
CONTENT_API_URL=op://VAULT/CONTENT_API/url
CF_ACCESS_CLIENT_ID=op://VAULT/CONTENT_EDITOR_ACCESS/client_id
CF_ACCESS_CLIENT_SECRET=op://VAULT/CONTENT_EDITOR_ACCESS/client_secret
CONTENT_GITHUB_TOKEN=op://VAULT/CONTENT_EDITOR_GITHUB/token
CONTENT_GITHUB_REPOSITORY=op://VAULT/CONTENT_EDITOR_GITHUB/repository
