{
  "name": "popyson-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "editor": "op run --env-file=.op.env -- node scripts/editorServer.mjs",
    "editor:build": "vite build --config editor/vite.config.js",
    "editor:dev": "op run --env-file=.op.env -- node scripts/editorServer.mjs --dev",
    "editor:setup": "node scripts/setupEditorTailscale.mjs",
    "editor:stop": "node scripts/stopEditorServer.mjs",
    "build": "vite build && node scripts/prerender.mjs && node scripts/build_pagefind.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest --project unit --project component",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "npm run build && vitest run --project integration",
    "coverage": "vitest run --project unit --project component --coverage",
    "metadata:generate": "node scripts/generate_metadata.mjs",
    "metadata:generate:op": "op run --env-file=.op.env -- node scripts/generate_metadata.mjs",
    "metadata:preview-prompts": "node scripts/generate_metadata.mjs --preview-prompts",
    "new:post": "node scripts/new_post.mjs",
    "new:work": "node scripts/new_work.mjs",
    "post:push": "node scripts/publish_content.mjs post",
    "work:push": "node scripts/publish_content.mjs work",
    "about:push": "node scripts/publish_content.mjs about --id about",
    "content:cloud:migrate": "node scripts/migrate_content_to_cloud.mjs",
    "content:cloud:migrate:op": "op run --env-file=.op.env -- node scripts/migrate_content_to_cloud.mjs",
    "content:pull": "op run --env-file=.op.env -- node scripts/pull_content_snapshot.mjs",
    "content:worker:test": "vitest run --root workers/content-api --config vitest.config.ts",
    "content:worker:typecheck": "tsc -p workers/content-api/tsconfig.json",
    "content:backup:test": "vitest run --root workers/content-backup --config vitest.config.ts",
    "content:backup:typecheck": "wrangler types --cwd workers/content-backup --check && tsc -p workers/content-backup/tsconfig.json",
    "content:restore": "node scripts/restore_content_backup.mjs",
    "lighthouse": "python3 scripts/run_lighthouse.py",
    "reading:fetch": "node scripts/fetch_instapaper.mjs",
    "reading:fetch:op": "op run --env-file=.op.env -- node scripts/fetch_instapaper.mjs",
    "instapaper:auth:op": "op run --env-file=.op.env.auth -- node scripts/instapaper_auth.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource/alexandria": "^5.3.0",
    "@tanstack/react-table": "^8.21.3",
    "codemirror": "^6.0.2",
    "heic-to": "^1.5.2",
    "jose": "^6.2.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intl": "^10.1.20",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "smarthr-ui": "^99.0.0",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@shikijs/rehype": "^4.3.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "happy-dom": "^20.11.1",
    "lighthouse": "^13.4.0",
    "pagefind": "^1.5.2",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.3.1",
    "smol-toml": "^1.8.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
