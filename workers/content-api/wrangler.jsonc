{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "popyson-content-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "content-api.popyson.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "https://setoshun00424.cloudflareaccess.com",
    "AUTHOR_POLICY_AUD": "fbc40438d9e141c9bcff9f8c0c110ca2870f5e680fd70eff483dbd2be468d214",
    "CI_POLICY_AUD": "3ac5fe277c103dd1b2c2e6bd01f7e6e7a9ffca858d325ab403b23c8969902c55",
    "AUTHOR_SERVICE_TOKEN_ID": "3ee65f4fa7d886c2ba85496a023e217d.access",
    "CI_SERVICE_TOKEN_ID": "dd7aab2a41fda062798e0568bb3bd18d.access",
    "MAX_JSON_BYTES": "1048576",
    "MAX_ASSET_BYTES": "10485760"
  },
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "popyson-content",
      "database_id": "18f57d00-966c-4f9d-ab14-d448b1d1b207",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT_ASSETS",
      "bucket_name": "popyson-content-assets"
    },
    {
      "binding": "CONTENT_BACKUPS",
      "bucket_name": "popyson-content-backups"
    }
  ]
}
