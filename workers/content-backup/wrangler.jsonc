{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "popyson-content-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    "crons": ["17 18 * * *"]
  },
  "vars": {
    "ACCOUNT_ID": "e4cad72de68b5d765bb6fb575926bb43",
    "DATABASE_ID": "18f57d00-966c-4f9d-ab14-d448b1d1b207"
  },
  "workflows": [
    {
      "name": "popyson-content-backup",
      "binding": "CONTENT_BACKUP_WORKFLOW",
      "class_name": "ContentBackupWorkflow"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT_ASSETS",
      "bucket_name": "popyson-content-assets"
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "popyson-content-backups"
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "popyson-content",
      "database_id": "18f57d00-966c-4f9d-ab14-d448b1d1b207"
    }
  ]
}
