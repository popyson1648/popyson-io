{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "popyson-editor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../editor/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "EDITOR_ORIGIN": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "EDITOR_EMAIL": ""
  }
}
